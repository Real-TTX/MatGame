<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>MatGame</RootNamespace>
    <AssemblyName>MatGame</AssemblyName>
  </PropertyGroup>

  <!--
    The games (plugins) are compiled in from the sibling repositories (../BunnyWarfare, ../KingBee, ../TurboToys: the same folder layout locally, in CI and in the Docker build).
    MatGameGames chooses them: "all" (default), "none", or a list like "bunnywarfare;kingbee". Each chosen game defines GAME_<ID> for Games.cs.
  -->
  <PropertyGroup>
    <MatGameGames Condition="'$(MatGameGames)' == ''">all</MatGameGames>
    <GameBunnyWarfare Condition="'$(MatGameGames)' == 'all' Or $([System.String]::Copy(';$(MatGameGames);').Contains(';bunnywarfare;'))">true</GameBunnyWarfare>
    <GameKingBee Condition="'$(MatGameGames)' == 'all' Or $([System.String]::Copy(';$(MatGameGames);').Contains(';kingbee;'))">true</GameKingBee>
    <GameTurboToys Condition="'$(MatGameGames)' == 'all' Or $([System.String]::Copy(';$(MatGameGames);').Contains(';turbotoys;'))">true</GameTurboToys>
    <DefineConstants Condition="'$(GameBunnyWarfare)' == 'true'">$(DefineConstants);GAME_BUNNYWARFARE</DefineConstants>
    <DefineConstants Condition="'$(GameKingBee)' == 'true'">$(DefineConstants);GAME_KINGBEE</DefineConstants>
    <DefineConstants Condition="'$(GameTurboToys)' == 'true'">$(DefineConstants);GAME_TURBOTOYS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MatGame.Sdk\MatGame.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(GameBunnyWarfare)' == 'true'">
    <ProjectReference Include="..\..\..\BunnyWarfare\src\BunnyWarfare.Module\BunnyWarfare.Module.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(GameKingBee)' == 'true'">
    <ProjectReference Include="..\..\..\KingBee\server\KingBee.Module\KingBee.Module.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(GameTurboToys)' == 'true'">
    <ProjectReference Include="..\..\..\TurboToys\src\TurboToys.Module\TurboToys.Module.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.*" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MatGame.Tests" />
  </ItemGroup>

</Project>
