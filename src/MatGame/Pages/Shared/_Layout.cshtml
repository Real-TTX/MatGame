@inject Assets Toolkit
@inject GameHost Games
@{
    // The shell of the ADMINISTRATION (players use the portal at "/" and the games). The games' admin pages (Razor pages of the plugins under
    // Pages/Admin/<Game>/) use this layout too. A page fills in: Title, PageSub (one line under it), Crumbs (a list of (Text, Url?)),
    // Width ("narrow" or "wide"), OwnHead (the page draws its own head).
    var actor = MatGame.Web.Identity.ToActor(User);
    var title = ViewData["Title"] as string ?? Ui.AppName;
    var sub = ViewData["PageSub"] as string;
    var crumbs = ViewData["Crumbs"] as IReadOnlyList<(string Text, string? Url)> ?? [];
    var width = ViewData["Width"] as string;
    var ownHead = ViewData["OwnHead"] is true;
    var path = Context.Request.Path.Value ?? "/";
    bool Under(string prefix) => path.Equals(prefix, StringComparison.OrdinalIgnoreCase) || path.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase);
    string Cls(bool active) => "mat-nav__item" + (active ? " is-active" : string.Empty);
    string Cur(bool active) => active ? "page" : null!;
    // in a game's menu the entry with the longest matching address is the current one (its overview /Admin/<Game> is a prefix of the others)
    var gameActive = Games.Games.SelectMany(g => g.Module.Admin).Where(l => Under(l.Path)).OrderByDescending(l => l.Path.Length).FirstOrDefault()?.Path;
    // the menus (SHELL-15): MatGame's own and one per game with admin pages; the switcher under the logo shows one at a time, the current page decides which
    var gameMenus = Games.Games.Where(g => g.Module.Admin.Count > 0).ToList();
    var currentMenu = gameMenus.FirstOrDefault(g => g.Module.Admin.Any(l => l.Path == gameActive))?.Info.Id ?? Ui.AppId;
    var currentTitle = gameMenus.FirstOrDefault(g => g.Info.Id == currentMenu)?.Info.Name ?? Ui.AppName;
    var currentIcon = currentMenu == Ui.AppId ? "layers" : "gamepad";
    var hasSwitcher = gameMenus.Count > 0;
}
<!DOCTYPE html>
<html lang="de" data-app="@Ui.AppId" data-dlg-ok="OK" data-dlg-cancel="Abbrechen" data-dlg-close="Schließen" data-dlg-confirm="Bestätigen" data-msg-required="Bitte ausfüllen.">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="@Ui.Accent" />
    <title>@title · @Ui.AppName</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <script src="~/matui/matui.boot.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/matui/matui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="mat-skip" href="#main">Zum Inhalt springen</a>
    @Html.Raw(Toolkit.Sprite)

    <div class="mat-app">
        <aside class="mat-nav" id="mat-nav">
            <div class="mat-nav__brand">
                <a href="/Admin" aria-label="Administration">
                    <img class="mat-brandmark mat-brandmark--light" src="~/img/logo.svg" alt="@Ui.AppName" width="168" height="40" />
                    <img class="mat-brandmark mat-brandmark--dark" src="~/img/logo-dark.svg" alt="@Ui.AppName" width="168" height="40" />
                </a>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-nav__close" data-nav-close aria-label="Menü schließen">@Ui.Icon("x")</button>
            </div>

            @if (hasSwitcher)
            {
                <div class="mat-nav__switch">
                    <button type="button" class="mat-switcher" data-menu-toggle="nav-switch-menu" data-menu-place="bottom" aria-haspopup="menu" aria-expanded="false">
                        <span class="mat-switcher__icon">@Ui.Icon(currentIcon)</span>
                        <span class="mat-switcher__text"><small data-nav-label="Menü">Menü</small><span class="mat-switcher__name">@currentTitle</span></span>
                        @Ui.Icon("chevron-down", "mat-switcher__chev")
                        <span class="mat-switcher__dot" hidden></span>
                    </button>
                </div>
            }

            <nav class="mat-nav__scroll" aria-label="@Ui.AppName" data-nav-panel="@Ui.AppId" hidden="@(currentMenu != Ui.AppId)">
                <ul class="mat-nav__list">
                    <li><a class="mat-nav__item mat-nav__item--primary" href="/">@Ui.Icon("gamepad")<span>Zu den Spielen</span></a></li>
                    <li><a class="@Cls(path.Equals("/Admin", StringComparison.OrdinalIgnoreCase))" href="/Admin" aria-current="@Cur(path.Equals("/Admin", StringComparison.OrdinalIgnoreCase))">@Ui.Icon("dashboard")<span>Übersicht</span></a></li>
                    <li><a class="@Cls(Under("/Admin/Accounts"))" href="/Admin/Accounts" aria-current="@Cur(Under("/Admin/Accounts"))">@Ui.Icon("users")<span>Konten</span></a></li>
                    <li><a class="@Cls(Under("/Admin/Devices"))" href="/Admin/Devices" aria-current="@Cur(Under("/Admin/Devices"))">@Ui.Icon("smartphone")<span>Geräte</span></a></li>
                    <li><a class="@Cls(Under("/Admin/Games"))" href="/Admin/Games" aria-current="@Cur(Under("/Admin/Games"))">@Ui.Icon("gamepad")<span>Spiele</span></a></li>
                    <li><a class="@Cls(Under("/Admin/Settings"))" href="/Admin/Settings" aria-current="@Cur(Under("/Admin/Settings"))">@Ui.Icon("settings")<span>Einstellungen</span></a></li>
                </ul>
            </nav>

            @foreach (var game in gameMenus)
            {
                <nav class="mat-nav__scroll" aria-label="@game.Info.Name" data-nav-panel="@game.Info.Id" hidden="@(currentMenu != game.Info.Id)">
                    <ul class="mat-nav__list">
                        <li><a class="mat-nav__item mat-nav__item--primary" href="/">@Ui.Icon("gamepad")<span>Zu den Spielen</span></a></li>
                        @foreach (var link in game.Module.Admin)
                        {
                            <li><a class="@Cls(link.Path == gameActive)" href="@link.Path" aria-current="@Cur(link.Path == gameActive)">@Ui.Icon(link.Icon)<span>@link.Title</span></a></li>
                        }
                    </ul>
                </nav>
            }

            <div class="mat-nav__foot">
                <div class="mat-nav__account">
                    <button type="button" class="mat-user" data-menu-toggle="user-menu" data-menu-place="top" aria-haspopup="menu" aria-expanded="false">
                        <span class="mat-avatar" aria-hidden="true">@Ui.Initials(actor.DisplayName)</span>
                        <span class="mat-user__text">
                            <span class="mat-user__name">@actor.DisplayName</span>
                            <span class="mat-user__role">@(actor.IsAdmin ? "Administrator" : "Spieler")</span>
                        </span>
                        @Ui.Icon("chevron-up", "mat-user__chev")
                    </button>
                    <button type="button" class="mat-theme" data-theme-toggle aria-label="Farbschema" title="Farbschema">
                        <svg class="mat-icon" data-theme-icon="system" aria-hidden="true" focusable="false"><use href="#mat-i-monitor"></use></svg>
                        <svg class="mat-icon" data-theme-icon="light" aria-hidden="true" focusable="false"><use href="#mat-i-sun"></use></svg>
                        <svg class="mat-icon" data-theme-icon="dark" aria-hidden="true" focusable="false"><use href="#mat-i-moon"></use></svg>
                    </button>
                </div>
                @* the version leads to the About page *@
                <div class="mat-nav__version"><a href="/About" title="Über MatGame">@AppInfo.Version</a></div>
            </div>
        </aside>

        <div class="mat-main">
            <header class="mat-topbar">
                <button type="button" class="mat-burger" data-nav-toggle aria-label="Menü öffnen" aria-controls="mat-nav" aria-expanded="false">@Ui.Icon("menu")</button>
                <nav class="mat-crumbs" aria-label="Brotkrumen">
                    <ol>
                        @if (crumbs.Count == 0)
                        {
                            <li aria-current="page">@title</li>
                        }
                        else
                        {
                            @for (var i = 0; i < crumbs.Count; i++)
                            {
                                var c = crumbs[i];
                                if (i == crumbs.Count - 1 || c.Url is null)
                                {
                                    <li aria-current="page">@c.Text</li>
                                }
                                else
                                {
                                    <li><a href="@c.Url">@c.Text</a></li>
                                }
                            }
                        }
                    </ol>
                </nav>
                <div class="mat-topbar__actions">
                    @await RenderSectionAsync("TopActions", required: false)
                    <a class="mat-btn mat-btn--primary mat-btn--icon" href="/" aria-label="Zu den Spielen" data-tip="Zu den Spielen">@Ui.Icon("gamepad")</a>
                </div>
            </header>

            <main class="mat-page @(width == "narrow" ? "mat-page--narrow" : width == "wide" ? "mat-page--wide" : "")" id="main">
                @if (!ownHead)
                {
                    <div class="mat-page__head">
                        <div class="mat-page__title">
                            <h1>@title</h1>
                            @if (!string.IsNullOrEmpty(sub))
                            {
                                <p class="mat-page__sub">@sub</p>
                            }
                        </div>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <div class="mat-menu" id="user-menu" role="menu" aria-label="@actor.DisplayName" hidden>
        <div class="mat-menu__head">
            <span class="mat-avatar" aria-hidden="true">@Ui.Initials(actor.DisplayName)</span>
            <div><strong>@actor.DisplayName</strong><small>@(actor.IsAdmin ? "Administrator" : "Spieler")</small></div>
        </div>
        <a class="mat-menu__item" role="menuitem" href="/">@Ui.Icon("gamepad")<span>Zu den Spielen</span></a>
        <a class="mat-menu__item" role="menuitem" href="/?profile=1">@Ui.Icon("user")<span>Mein Profil</span></a>
        <div class="mat-menu__sep" role="separator"></div>
        <form method="post" action="/Account/Logout">
            @Html.AntiForgeryToken()
            <button type="submit" class="mat-menu__item mat-menu__item--danger" role="menuitem">@Ui.Icon("logout")<span>Abmelden</span></button>
        </form>
    </div>

    @if (hasSwitcher)
    {
        @* the popup of the menu switcher: MatGame's menu, then one per game (each shows its panel in the menu, without loading a page) *@
        <div class="mat-menu" id="nav-switch-menu" role="menu" aria-label="Menüs" data-nav-scope="mat-nav" hidden>
            <button type="button" class="mat-menu__item" role="menuitemradio" aria-checked="@(currentMenu == Ui.AppId ? "true" : "false")" data-nav-set="@Ui.AppId" data-nav-title="@Ui.AppName">
                @Ui.Icon("layers")<span>@Ui.AppName</span>@Ui.Icon("check", "mat-menu__check")
            </button>
            @foreach (var game in gameMenus)
            {
                <button type="button" class="mat-menu__item" role="menuitemradio" aria-checked="@(currentMenu == game.Info.Id ? "true" : "false")" data-nav-set="@game.Info.Id" data-nav-title="@game.Info.Name">
                    @Ui.Icon("gamepad")<span>@game.Info.Name</span>@Ui.Icon("check", "mat-menu__check")
                </button>
            }
        </div>
    }

    @if (TempData["Flash"] is string flash)
    {
        <div data-toast="@flash" data-tone="success" hidden></div>
    }

    @if (TempData["FlashError"] is string flashError)
    {
        <div data-toast="@flashError" data-tone="danger" hidden></div>
    }

    <script src="~/matui/matui.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
